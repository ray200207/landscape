# Urban Landscape Lab — 環境變數設定範例
# 複製此檔案為 .env 並填入實際值

# 資料庫（預設 SQLite，生產環境可改 PostgreSQL）
DATABASE_URL=sqlite+aiosqlite:///./landscape.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/landscape_db

# AI 模式設定
USE_MOCK_AI=true   # 改為 false 以啟用真實 Gemini API

# Gemini API 金鑰（USE_MOCK_AI=false 時需要）
# 取得方式：https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=你的金鑰
